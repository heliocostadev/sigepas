{
  "name": "transporte-sanitario",
  "version": "0.1.0",
  "description": "Núcleo de domínio do sistema de agendamento de transporte sanitário",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "verificar": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
