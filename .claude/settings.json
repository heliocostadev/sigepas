{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh release create:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh pr review:*)",
      "PowerShell(gh pr edit:*)",
      "PowerShell(gh issue create:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh issue edit:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(gh release create:*)",
      "PowerShell(terraform apply:*)",
      "PowerShell(terraform destroy:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/mostrar-onde-parei.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-segredo-no-commit.mjs\""
          }
        ]
      }
    ]
  }
}
